VUE_APP_API_URL=https://api.uptimerobot.com/v2/getMonitors
VUE_APP_API_KEY=your_uptimerobot_api_key_here
PORT=5002
ADMIN_PASSWORD=your_admin_password_here
VITE_API_TARGET=https://example.com:10003

# 后台 JWT 签名密钥：务必设置。缺失时服务端会在启动时随机生成，
# 后果是每次重启都会让所有登录态失效（管理员需重新登录）。
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your_random_jwt_secret_here

# 服务端访问应用市场上游时用的 User-Agent —— 全站唯一一处标识，所有打上游的请求都用它。
#
# 上游规定：调用 API 必须带 user_agent，标准格式为「应用包名/版本号」，
# 例如 top.rayawa.dashboard/2.0.0（那只是文档里的示例，换成你自己的）。
# 所以不要用浏览器 UA，也不要原样透传访客的 UA：上游要认的是「谁在调接口」。
# 内容可以稍微自由发挥，只要能辨认出来即可；换名字/版本号只改这一行。
UPSTREAM_USER_AGENT=OpenStore/1.0 (+https://next.betahub.tech)
# 服务端对上游的全局限流：最大并发 + 两次请求最小间隔
UPSTREAM_MAX_CONCURRENCY=2
UPSTREAM_MIN_INTERVAL_MS=250

# 反向代理层数。线上链路是「用户 → EdgeOne(CDN) → nginx → Node」，所以填 2（也是默认值）；
# 只有 nginx 一层时填 1（或 loopback），完全直连没有代理时填 false。
# 它决定 req.ip 取 X-Forwarded-For 的哪一段，进而决定各处按 IP 的限流是否可信。
# 注意：取访客 IP 用的是下面的 TRUSTED_FRONT_PROXY_IPS + CDN 头，不是这里。
TRUST_PROXY=2

# 自己的前置反代（把本站整个代理出去的那台机器）的 IP，逗号分隔，例如：
# TRUSTED_FRONT_PROXY_IPS=139.9.223.233
# 链路「访客 → 前置反代 → EdgeOne → nginx → Node」下，EdgeOne 看到的连接方是代理机，
# CDN 头只会给出代理机 IP；只有 CDN 头命中这个名单时，服务端才会改用 X-Forwarded-For
# 最左段里的真实访客 IP。前提是那台代理机配置了转发访客 IP（见部署说明）。
TRUSTED_FRONT_PROXY_IPS=

# 出站代理与上传的护栏（留空即用代码里的默认值）
MUSIC_PROXY_MAX_BYTES=209715200   # /api/music-proxy 单次传输上限，默认 200MB
MUSIC_PROXY_MAX_PER_IP=4          # /api/music-proxy 同一 IP 并发传输数上限
UPLOAD_MAX_BYTES=268435456        # /api/upload 单文件上限，默认 256MB
PROXY_ALLOWED_ORIGINS=            # /api/proxy-request 额外放行的 origin（逗号分隔），默认只有 music_apis 表里的

# 限流阈值（0 表示关闭对应限流）
LOGIN_MAX_FAILURES=5              # 登录失败多少次后锁定
LOGIN_LOCK_MS=900000              # 锁定时长，默认 15 分钟
COMMENT_RATE_LIMIT_PER_MINUTE=5   # 同一 IP 每分钟最多发几条评论
FEEDBACK_RATE_LIMIT_PER_MINUTE=5  # 同一 IP 每分钟最多提交几条反馈

# /api/public/apps/overview 的缓存策略：新鲜期 / 旧数据兜底期（毫秒）
APP_OVERVIEW_CACHE_TTL_MS=1800000
APP_OVERVIEW_STALE_TTL_MS=86400000
