VUE_APP_API_URL=https://api.uptimerobot.com/v2/getMonitors
VUE_APP_API_KEY=your_uptimerobot_api_key_here
PORT=5002
ADMIN_PASSWORD=your_admin_password_here
VITE_API_TARGET=https://example.com:10003
VITE_NEXT_API_TARGET=https://next.example.cn

# 服务端访问上游时的身份标识（上游要求"明确 UA"，避免被判长期高频请求）
UPSTREAM_USER_AGENT=OpenStore/1.0 (+https://next.betahub.tech)
# 服务端对上游的全局限流：最大并发 + 两次请求最小间隔
UPSTREAM_MAX_CONCURRENCY=2
UPSTREAM_MIN_INTERVAL_MS=250

# /api/public/apps/overview 的缓存策略：新鲜期 / 旧数据兜底期（毫秒）
APP_OVERVIEW_CACHE_TTL_MS=1800000
APP_OVERVIEW_STALE_TTL_MS=86400000
